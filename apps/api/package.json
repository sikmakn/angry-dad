{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "prestart": "npm --prefix ../.. run generate:openapi",
    "start": "nest start",
    "prestart:dev": "npm --prefix ../.. run generate:openapi",
    "start:dev": "nest start --watch",
    "prestart:debug": "npm --prefix ../.. run generate:openapi",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "npm --prefix ../.. run lint",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "node ../../scripts/testing/with-test-mongo.mjs -- node ../../node_modules/jest/bin/jest.js",
    "test:watch": "node ../../scripts/testing/with-test-mongo.mjs -- node ../../node_modules/jest/bin/jest.js --watch",
    "test:cov": "node ../../scripts/testing/with-test-mongo.mjs -- node ../../node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node ../../scripts/testing/with-test-mongo.mjs -- node --inspect-brk -r tsconfig-paths/register -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand",
    "start:worker": "node dist/worker"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "grammy": "^1.46.0",
    "mongoose": "^8.24.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.spec.json"
        }
      ],
      "node_modules/@nestjs/event-emitter/.+\\.js$": [
        "ts-jest",
        {
          "useESM": false,
          "tsconfig": {
            "allowJs": true,
            "module": "CommonJS",
            "moduleResolution": "Node10",
            "resolvePackageJsonExports": false
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!@nestjs/event-emitter/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/helpers/env.setup.ts"
    ]
  }
}
